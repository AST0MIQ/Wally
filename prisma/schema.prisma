// Wally — Prisma schema
// See docs/ARCHITECTURE.md §H/§I for the design rationale.
//
// Conventions:
//  - All monetary amounts use `Decimal` (never Float).
//  - Every user-owned row carries `userId`; all queries filter by the
//    session-derived userId (see src/server/lib/guards.ts).
//  - Soft delete via `deletedAt` on financial records.
//  - `idempotencyKey` guards against duplicate submits.
//  - Auth.js model is `Account`; the business account model is `FinanceAccount`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// Auth (Auth.js v5)
// ─────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerified   DateTime?
  name            String?
  image           String?
  role            Role      @default(USER)
  locale          Locale    @default(TH)
  baseCurrency    String    @default("THB") // ISO 4217
  timezone        String    @default("Asia/Bangkok")
  theme           Theme     @default(SYSTEM)
  accent          String    @default("blue")
  lastSeenVersion String    @default("1.0.0")
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // ── Logging streak (consecutive days the user recorded something) ──
  streakCount      Int       @default(0)
  streakBest       Int       @default(0)
  streakLastDate   DateTime? // UTC midnight of the last counted wall-clock day
  streakFreezeAt   DateTime? // when the monthly "forgive one day" was last used
  streakCelebrated Int       @default(0) // highest tier index already celebrated

  accounts          Account[]
  sessions          Session[]
  financeAccounts   FinanceAccount[]
  categories        Category[]
  transactions      Transaction[]
  transfers         Transfer[]
  portfolios        Portfolio[]
  investmentTxns    InvestmentTransaction[]
  netWorthSnapshots NetWorthSnapshot[]
  recurringRules    RecurringRule[]
  auditLogs         AuditLog[]

  // ── Cosmetics (Phase 1) ──
  cosmeticEntitlements       UserEntitlement[]
  equippedCosmetics          UserEquippedAsset[]
  createdCosmeticCollections CosmeticCollection[] @relation("CollectionCreatedBy")
  createdCosmeticAssets      CosmeticAsset[]      @relation("AssetCreatedBy")
  grantedEntitlements        UserEntitlement[]    @relation("EntitlementGrantedBy")
  revokedEntitlements        UserEntitlement[]    @relation("EntitlementRevokedBy")

  // ── Access control (database-backed RBAC) ──
  userRoles              UserRole[]
  assignedUserRoles      UserRole[]       @relation("UserRoleAssignedBy")
  grantedRolePermissions RolePermission[] @relation("RolePermissionGrantedBy")

  @@index([createdAt])
}

enum Role {
  USER
  ADMIN
}

enum Locale {
  TH
  EN
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────
// Accounts
// ─────────────────────────────────────────────────────────────

model FinanceAccount {
  id                 String        @id @default(cuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  type               AccountType   @default(BANK)
  customTypeLabel    String?
  openingBalance     Decimal       @default(0) @db.Decimal(18, 4)
  openingBalanceDate DateTime      @default(now())
  currency           String // ISO 4217
  icon               String?
  color              String?
  status             AccountStatus @default(ACTIVE)
  sortOrder          Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  transactions  Transaction[]
  transfersFrom Transfer[]              @relation("TransferFrom")
  transfersTo   Transfer[]              @relation("TransferTo")
  transfersFee  Transfer[]              @relation("TransferFee")
  portfolios    Portfolio[]
  settlementFor InvestmentTransaction[] @relation("Settlement")

  @@index([userId, status, sortOrder])
}

enum AccountType {
  CASH
  BANK
  EWALLET
  SAVINGS
  INVESTMENT
  OTHER
}

enum AccountStatus {
  ACTIVE
  ARCHIVED
}

// ─────────────────────────────────────────────────────────────
// Category / Subcategory
// ─────────────────────────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  // systemKey is set for seeded default categories so the UI can translate
  // them via i18n; null for user-created categories (show `name` verbatim).
  systemKey String?
  kind      TxnKind
  icon      String?
  color     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subcategories Subcategory[]
  transactions  Transaction[]

  @@index([userId, kind])
}

model Subcategory {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  systemKey  String?
  icon       String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  transactions Transaction[]

  @@index([categoryId])
}

enum TxnKind {
  INCOME
  EXPENSE
}

// ─────────────────────────────────────────────────────────────
// Transactions (Income / Expense only — transfers live in Transfer)
// ─────────────────────────────────────────────────────────────

model Transaction {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           TxnKind
  amount         Decimal        @db.Decimal(18, 4) // always > 0
  currency       String // = account.currency at creation time
  accountId      String
  account        FinanceAccount @relation(fields: [accountId], references: [id])
  categoryId     String?
  category       Category?      @relation(fields: [categoryId], references: [id])
  subcategoryId  String?
  subcategory    Subcategory?   @relation(fields: [subcategoryId], references: [id])
  date           DateTime
  description    String?
  note           String?
  source         TxnSource      @default(MANUAL)
  idempotencyKey String?        @unique
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId, date])
  @@index([userId, accountId, date])
  @@index([userId, categoryId, date])
  @@index([userId, kind, date])
}

enum TxnSource {
  MANUAL
  SYSTEM
  IMPORT
  RECURRING
}

// ─────────────────────────────────────────────────────────────
// Transfer (kept separate so analytics can never miscount it)
// ─────────────────────────────────────────────────────────────

model Transfer {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccountId  String
  fromAccount    FinanceAccount  @relation("TransferFrom", fields: [fromAccountId], references: [id])
  toAccountId    String
  toAccount      FinanceAccount  @relation("TransferTo", fields: [toAccountId], references: [id])
  fromAmount     Decimal         @db.Decimal(18, 4)
  toAmount       Decimal         @db.Decimal(18, 4)
  fromCurrency   String
  toCurrency     String
  fee            Decimal         @default(0) @db.Decimal(18, 4)
  feeAccountId   String?
  feeAccount     FinanceAccount? @relation("TransferFee", fields: [feeAccountId], references: [id])
  date           DateTime
  note           String?
  idempotencyKey String?         @unique
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId, date])
}

// ─────────────────────────────────────────────────────────────
// Investment
// ─────────────────────────────────────────────────────────────

model Portfolio {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId    String
  account      FinanceAccount @relation(fields: [accountId], references: [id])
  name         String         @default("Investment Portfolio")
  baseCurrency String         @default("USD")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  transactions InvestmentTransaction[]

  @@index([userId])
}

model Security {
  id            String       @id @default(cuid())
  symbol        String
  exchange      String?
  name          String
  type          SecurityType @default(STOCK)
  currency      String       @default("USD")
  finnhubSymbol String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  prices       SecurityPrice[]
  transactions InvestmentTransaction[]

  @@unique([symbol, exchange])
}

enum SecurityType {
  STOCK
  ETF
  CRYPTO
  FUND
  OTHER
}

model SecurityPrice {
  id         String   @id @default(cuid())
  securityId String
  security   Security @relation(fields: [securityId], references: [id], onDelete: Cascade)
  price      Decimal  @db.Decimal(18, 6)
  currency   String
  asOf       DateTime
  source     String // 'finnhub' | 'manual'
  fetchedAt  DateTime @updatedAt

  @@unique([securityId, asOf, source])
  @@index([securityId, asOf])
}

model InvestmentTransaction {
  id                  String          @id @default(cuid())
  userId              String
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolioId         String
  portfolio           Portfolio       @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  securityId          String
  security            Security        @relation(fields: [securityId], references: [id])
  type                InvTxnType
  quantity            Decimal         @db.Decimal(28, 10)
  price               Decimal         @db.Decimal(18, 6)
  fee                 Decimal         @default(0) @db.Decimal(18, 6)
  amount              Decimal         @db.Decimal(18, 6) // BUY: qty*price + fee ; SELL: qty*price - fee
  currency            String
  tradeDate           DateTime
  settlementAccountId String?
  settlementAccount   FinanceAccount? @relation("Settlement", fields: [settlementAccountId], references: [id])
  note                String?
  idempotencyKey      String?         @unique
  deletedAt           DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([userId, portfolioId, tradeDate])
  @@index([securityId])
}

enum InvTxnType {
  BUY
  SELL
}

// ─────────────────────────────────────────────────────────────
// Reference / system
// ─────────────────────────────────────────────────────────────

model FxRate {
  id        String   @id @default(cuid())
  base      String
  quote     String
  rate      Decimal  @db.Decimal(18, 8)
  asOf      DateTime // date-only (00:00 UTC)
  source    String
  fetchedAt DateTime @updatedAt

  @@unique([base, quote, asOf])
  @@index([base, quote, asOf])
}

model NetWorthSnapshot {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime // date-only
  baseCurrency    String
  totalCash       Decimal  @db.Decimal(18, 4)
  totalInvestment Decimal  @db.Decimal(18, 4)
  totalNetWorth   Decimal  @db.Decimal(18, 4)
  createdAt       DateTime @default(now())

  @@unique([userId, date])
}

model RecurringRule {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payload   Json // template + rrule string — schema only, not implemented yet
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  entity    String
  entityId  String
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Cosmetics — modular theme/inventory system (Phase 1)
// A "theme" is a CosmeticCollection of independently equippable
// CosmeticAssets, each bound to one EquipmentSlot. Ownership
// (UserEntitlement) is modelled separately from equipped state
// (UserEquippedAsset). See docs/COSMETICS.md.
// ─────────────────────────────────────────────────────────────

enum EquipmentSlot {
  APP_BACKGROUND
  NAVIGATION
  HEADER
  PROFILE_FRAME
  PROFILE_BADGE
  PROFILE_AURA
  OVERVIEW_CARD
  ACCOUNT_CARD
  INVESTMENT_CARD
  TRANSACTION_CARD
  CHART_STYLE
  ICON_SET
  TYPOGRAPHY
  AMBIENT_EFFECT
  INTERACTION_EFFECT
  CELEBRATION_EFFECT
}

enum CosmeticRarity {
  COMMON
  RARE
  EPIC
  SPECIAL
  LIMITED
}

enum CosmeticStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  ARCHIVED
}

enum AcquisitionType {
  DEFAULT
  STREAK_REWARD
  RANK_REWARD
  ACHIEVEMENT
  PURCHASE
  LIMITED_EVENT
  ADMIN_GRANT
}

enum EntitlementStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum RewardTrigger {
  STREAK_MILESTONE
  RANK_MILESTONE
  ACHIEVEMENT
  MANUAL
}

/// The independently equippable item. `slot` is set at creation and never
/// changes (guarded in the service + relied on by composite FKs). `config`
/// and `configVersion` are frozen once the asset has been published.
model CosmeticAsset {
  id                 String          @id @default(cuid())
  slug               String          @unique
  name               String
  description        String?
  slot               EquipmentSlot
  rarity             CosmeticRarity  @default(COMMON)
  status             CosmeticStatus  @default(DRAFT)
  acquisitionType    AcquisitionType @default(ADMIN_GRANT)
  /// exactly one canonical default per slot (partial unique index, see migration)
  isCanonicalDefault Boolean         @default(false)
  configVersion      Int             @default(1)
  /// validated by src/lib/cosmetics/config.ts — never raw CSS/JS
  config             Json
  previewUrl         String?
  /// first time this asset entered PUBLISHED; presence ⇒ config is frozen
  publishedAt        DateTime?
  createdByAdmin     User?           @relation("AssetCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  createdByAdminId   String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  collections  CollectionAsset[]
  entitlements UserEntitlement[]
  equipped     UserEquippedAsset[]
  rewardRules  RewardRule[]        @relation("RewardGrantsAsset")

  // composite target so CollectionAsset / UserEquippedAsset can enforce
  // "join.slot == asset.slot" via a composite foreign key
  @@unique([id, slot])
  @@index([slot, status])
  @@index([status])
}

/// A themed bundle of assets. Can be applied as a whole set (isApplicableAsSet).
model CosmeticCollection {
  id                String         @id @default(cuid())
  slug              String         @unique
  name              String
  description       String?
  coverUrl          String?
  rarity            CosmeticRarity @default(COMMON)
  status            CosmeticStatus @default(DRAFT)
  isApplicableAsSet Boolean        @default(true)
  availableFrom     DateTime?
  availableTo       DateTime?
  sortOrder         Int            @default(0)
  /// first time this collection entered PUBLISHED; once set, membership is
  /// frozen forever (a revised set needs "Duplicate as draft")
  publishedAt       DateTime?
  createdByAdmin    User?          @relation("CollectionCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  createdByAdminId  String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  assets             CollectionAsset[]
  entitlementSources UserEntitlement[] @relation("EntitlementSourceCollection")
  rewardRules        RewardRule[]      @relation("RewardGrantsCollection")

  @@index([status])
  @@index([rarity])
}

/// Join: which assets belong to a collection. At most one asset per slot per
/// collection (@@unique([collectionId, slot])), so applying a collection is
/// deterministic. `slot` mirrors the asset's slot and is enforced by the
/// composite FK below.
model CollectionAsset {
  id           String             @id @default(cuid())
  collectionId String
  collection   CosmeticCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  assetId      String
  slot         EquipmentSlot
  asset        CosmeticAsset      @relation(fields: [assetId, slot], references: [id, slot], onDelete: Cascade)
  sortOrder    Int                @default(0)
  createdAt    DateTime           @default(now())

  @@unique([collectionId, assetId])
  @@unique([collectionId, slot])
  @@index([assetId])
}

/// Ownership. Separate from equipped state. Idempotent grants via the
/// [userId, assetId] unique — re-granting un-revokes and refreshes.
/// Grant/revoke history lives in AuditLog.
model UserEntitlement {
  id                 String              @id @default(cuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId            String
  asset              CosmeticAsset       @relation(fields: [assetId], references: [id], onDelete: Restrict)
  sourceCollection   CosmeticCollection? @relation("EntitlementSourceCollection", fields: [sourceCollectionId], references: [id], onDelete: SetNull)
  sourceCollectionId String?
  acquisitionType    AcquisitionType
  sourceRef          String?
  status             EntitlementStatus   @default(ACTIVE)
  firstGrantedAt     DateTime            @default(now())
  grantedAt          DateTime            @default(now())
  grantedByAdmin     User?               @relation("EntitlementGrantedBy", fields: [grantedByAdminId], references: [id], onDelete: SetNull)
  grantedByAdminId   String?
  expiresAt          DateTime?
  revokedByAdmin     User?               @relation("EntitlementRevokedBy", fields: [revokedByAdminId], references: [id], onDelete: SetNull)
  revokedByAdminId   String?
  revokedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([userId, assetId])
  @@index([userId, status])
  @@index([assetId])
  @@index([expiresAt])
}

/// Equipped state — the user's loadout is the set of these rows. One asset
/// per slot (@@unique([userId, slot])). The composite FK guarantees the
/// equipped row's slot matches the asset's slot at the DB layer.
model UserEquippedAsset {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot       EquipmentSlot
  assetId    String
  asset      CosmeticAsset @relation(fields: [assetId, slot], references: [id, slot], onDelete: Restrict)
  equippedAt DateTime      @default(now())

  @@unique([userId, slot])
  @@index([assetId])
}

/// Future-facing: streak/rank/achievement reward rules. Phase 1 = admin CRUD
/// only, no automation engine. Grants exactly one target (collection XOR
/// asset) — enforced by Zod + a CHECK constraint (see migration).
model RewardRule {
  id                 String              @id @default(cuid())
  key                String              @unique
  name               String
  description        String?
  trigger            RewardTrigger
  threshold          Int?
  grantsCollection   CosmeticCollection? @relation("RewardGrantsCollection", fields: [grantsCollectionId], references: [id], onDelete: Restrict)
  grantsCollectionId String?
  grantsAsset        CosmeticAsset?      @relation("RewardGrantsAsset", fields: [grantsAssetId], references: [id], onDelete: Restrict)
  grantsAssetId      String?
  isActive           Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([trigger, isActive])
}

// ─────────────────────────────────────────────────────────────
// Access control — database-backed RBAC
// A user holds many roles (UserRole); each role grants many
// permissions (RolePermission). Authorization is the UNION of every
// permission from every non-archived role the user holds. `resource.action`
// permission keys are the only authorization primitive — role NAMES are
// never checked, except the single narrowly-defined SUPER_ADMIN bypass and
// the ADMIN_EMAILS bootstrap. The model is named AccessRole (not Role)
// because the legacy `Role` enum (USER | ADMIN) still lives on User.role.
// See src/server/lib/rbac.ts.
// ─────────────────────────────────────────────────────────────

/// A named bundle of permissions. System roles are seeded; their `key` is
/// immutable and their permission set is locked. Custom roles are fully
/// editable. A role that has ever been assigned or referenced in the audit
/// log is archived (archivedAt), never hard-deleted. Archived roles cannot
/// be assigned.
model AccessRole {
  id          String    @id @default(cuid())
  key         String    @unique
  name        String
  description String?
  isSystem    Boolean   @default(false)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@index([archivedAt])
  @@index([isSystem])
}

/// The permission catalogue. Keys are stable `resource.action` strings and
/// are never renamed or deleted once shipped (that would silently rewrite
/// authorization history). Seeded from prisma/data/rbac.ts.
model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([resource, action])
  @@index([resource])
}

/// Join: the permissions a role grants. Cascade-deletes with either side (a
/// custom role that is still hard-deletable has no assignments, so dropping
/// its RolePermission rows with it is safe).
model RolePermission {
  roleId          String
  permissionId    String
  grantedByUserId String?
  createdAt       DateTime @default(now())

  role       AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedBy  User?      @relation("RolePermissionGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

/// A role assignment, always keyed by userId (never email). Revocation hard-
/// deletes the row; the append-only AuditLog is the history. `role` uses
/// onDelete: Restrict so a role with live assignments cannot be deleted — it
/// must be archived instead.
model UserRole {
  id               String   @id @default(cuid())
  userId           String
  roleId           String
  assignedByUserId String?
  assignedAt       DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       AccessRole @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy User?      @relation("UserRoleAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([roleId])
  @@index([userId])
}
